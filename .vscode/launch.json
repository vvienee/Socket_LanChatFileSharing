{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Peer 1: Quan (Port 5001)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--name", "Quan",
                "--port", "5001",
                "--broadcast", "127.255.255.255"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Peer 2: Minh (Port 5002)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--name", "Minh",
                "--port", "5002",
                "--broadcast", "127.255.255.255"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Peer 3: Huy (Port 5003)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--name", "Huy",
                "--port", "5003",
                "--broadcast", "127.255.255.255"
            ],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Launch 3 Peers on 1 PC (Quan, Minh, Huy)",
            "configurations": [
                "Peer 1: Quan (Port 5001)",
                "Peer 2: Minh (Port 5002)",
                "Peer 3: Huy (Port 5003)"
            ],
            "stopAll": true
        }
    ]
}
